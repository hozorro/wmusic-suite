# ====================== 复制为 .env 后再修改 ======================
# cp .env.example .env
#
# ===========================================================================

# ---- 基础 ----
TZ=Asia/Shanghai
IMAGE_TAG=latest
HTTP_PORT=8080                 # 对外暴露端口

# ---- PostgreSQL ----
POSTGRES_DB=musicbase
POSTGRES_USER=musicbase
POSTGRES_PASSWORD=change_me_please

# ---- 宿主机目录映射（Windows / Linux 都写绝对路径）----
# Linux NAS 示例：
#   MUSIC_DIR=/volume1/music
#   MEDIA_DIR=/volume1/docker/musicbase/media
# Windows Docker Desktop 示例（注意用正斜杠）：
#   MUSIC_DIR=D:/Music
#   MEDIA_DIR=D:/Docker/musicbase/media
MUSIC_DIR=/path/to/your/music
# 媒体根：artwork / uploads/temp / uploads/staging 都在它下面（后端由 MEDIA_ROOT 派生）。
MEDIA_DIR=/path/to/your/media
BACKUP_DIR=./backups

# ---- 文件权限：必须等于宿主机音乐库目录的属主 ----
# Linux 查看： stat -c '%u:%g' /path/to/music
# Windows / 群晖一般直接填 1000:1000 或你的账号 uid
PUID=1000
PGID=1000
UMASK=022                      # 新建文件权限：022->644/755；002->664/775（按组共享音乐库时用）

# ---- 容器网络（可选，默认值一般无需改动）----
# MUSICBASE_SUBNET=172.28.0.0/16
# DB_IPV4=172.28.0.11
# API_IPV4=172.28.0.10

# ---- 构建开关 ----
INSTALL_FFMPEG=false           # 需要转码/抽视频封面时改 true（镜像 +80MB）

# ---- 音频指纹工具 fpcalc（构建时从官方 release 下载 linux 静态二进制）----
FPCALC_VERSION=1.6.1
# 直连 GitHub 失败时，改成加速前缀（注意要保留 https://github.com 这一段）
# FPCALC_MIRROR=https://ghfast.top/https://github.com

# ---- 音乐库监控（watcher 服务）----
# inotify：事件驱动、开销低，但只在 Linux 直挂真实文件系统（ext4/btrfs/xfs）时可靠
# polling：轮询，Docker Desktop(Windows/macOS) 的 bind mount、以及 NFS/SMB 必须用它
# ⚠️ 要生效需先给后端 watcher.py 打补丁（DEVDOC.md §4.5「监控模式」），否则本项会被忽略
WATCH_MODE=polling

# ---- 容器启动行为 ----
RUN_MIGRATIONS=true            # 启动时自动 alembic upgrade head（仅 api 服务执行）
WAIT_FOR_DB=true
UVICORN_WORKERS=1              # 涉及文件整理/归档，建议保持 1（多 worker 会并发写同一文件）
CHOWN_LIBRARY=false            # 音乐库宿主权限不对时，置 true 让容器一次性递归修正（大库很慢）