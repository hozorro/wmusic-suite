# ====================== 复制为 .env 后再修改 ======================
# cp .env.example .env
#
# ===========================================================================
# 这份文件【只放编排参数】—— 宿主机路径、端口、数据库凭据、构建开关。
# 它只被 docker-compose.yml 的 ${} 引用，**不会进入任何容器**。
#
# 后端的应用配置（SECRET_KEY / ACOUSTID_API_KEY / NETEASE_* 等）在另一处：
#     musicbase/.env        ← cp musicbase/.env.example musicbase/.env
# 那个文件经 compose 的 env_file 注入 api 容器，后端 Settings 直接读它。
#
# 为什么拆成两份：
#   1. 顶层 .env 曾同时承担「compose 插值」和「全量注入容器」两种身份，
#      结果 MUSIC_DIR / HTTP_PORT / BACKUP_DIR 这些宿主机概念被灌进容器。
#      一旦后端将来新增同名字段，它会静默读到宿主机路径 —— 定时炸弹。
#   2. musicbase/.env 与后端源码同处一室，后端开发者本地起服务时读的就是它，
#      真正做到「一份配置，两种运行方式」。
# ===========================================================================

# ---- 基础 ----
TZ=Asia/Shanghai
IMAGE_TAG=latest
HTTP_PORT=8080                 # 对外暴露端口

# ---- PostgreSQL ----
# 这三个值同时供 db 服务和 api 的 DB_* 使用（compose 里做插值复用，不必填两遍）
POSTGRES_DB=musicbase
POSTGRES_USER=musicbase
POSTGRES_PASSWORD=change_me_please

# ---- 宿主机目录映射（Windows / Linux 都写绝对路径）----
# Linux NAS 示例：
#   MUSIC_DIR=/volume1/music
#   MEDIA_DIR=/volume1/docker/musicbase/media
#   ARTWORK_DIR=/volume1/docker/musicbase/artwork
# Windows Docker Desktop 示例（注意用正斜杠）：
#   MUSIC_DIR=D:/Music
#   MEDIA_DIR=D:/Docker/musicbase/media
#   ARTWORK_DIR=D:/Docker/musicbase/artwork
MUSIC_DIR=/path/to/your/music

# 媒体根：artwork / uploads/temp / uploads/staging 都在它下面（后端由 MEDIA_ROOT 派生）。
# ⚠️ 必须与 MUSIC_DIR 在同一物理卷！归档入库用 shutil.move，跨设备会静默降级成
#    「复制后删除」——大文件慢，复制中途失败还会在音乐库里留半个文件。
#    Linux 上可用 stat 比对设备号，make check 也会自动查：
#      stat -c '%d %n' "$MUSIC_DIR" "$MEDIA_DIR"      # 两行的数字必须相同
MEDIA_DIR=/path/to/your/media

# artwork 缓存目录（单独挂载，会覆盖 MEDIA_ROOT/artwork）。
# 不需要独立目录时，可以把 compose 里那一行 volumes 注释掉，改用 MEDIA_DIR/artwork。
ARTWORK_DIR=/path/to/your/artwork-cache
BACKUP_DIR=./backups

# ---- 文件权限：必须等于宿主机音乐库目录的属主 ----
# Linux 查看： stat -c '%u:%g' /path/to/music
# Windows / 群晖一般直接填 1000:1000 或你的账号 uid
PUID=1000
PGID=1000
UMASK=022                      # 新建文件权限：022->644/755；002->664/775（按组共享音乐库时用）

# ---- 容器网络（可选，默认值一般无需改动）----
# nginx 的 upstream 只解析一次主机名，所以给 api/db 钉了静态 IP 防止重建后 502。
# 若默认值与宿主机现有 Docker 网络冲突，检查命令：
#   docker network inspect $(docker network ls -q) | grep -i subnet
# MUSICBASE_SUBNET=172.28.0.0/16
# DB_IPV4=172.28.0.11
# API_IPV4=172.28.0.10

# ---- 构建开关 ----
INSTALL_FFMPEG=false           # 需要转码/抽视频封面时改 true（镜像 +80MB）
VITE_ENABLE_PWA=true

# ---- 音频指纹工具 fpcalc（构建时从官方 release 下载 linux 静态二进制）----
# 用它的原因见 docker/backend/Dockerfile 的 Stage 2 注释：静态链接、自带 mp3/flac
# 解码，且【不会】触发 pyacoustid 走 audioread 分支。
FPCALC_VERSION=1.6.1
# 直连 GitHub 失败时，改成加速前缀（注意要保留 https://github.com 这一段）
# FPCALC_MIRROR=https://ghfast.top/https://github.com

# ---- 音乐库监控（watcher 服务）----
# inotify：事件驱动、开销低，但只在 Linux 直挂真实文件系统（ext4/btrfs/xfs）时可靠
# polling：轮询，Docker Desktop(Windows/macOS) 的 bind mount、以及 NFS/SMB 必须用它
# ⚠️ 要生效需先给后端 watcher.py 打补丁（README「监控模式」），否则本项会被忽略
WATCH_MODE=polling

# ---- 容器启动行为 ----
RUN_MIGRATIONS=true            # 启动时自动 alembic upgrade head（仅 api 服务执行）
WAIT_FOR_DB=true
UVICORN_WORKERS=1              # 涉及文件整理/归档，建议保持 1（多 worker 会并发写同一文件）
CHOWN_LIBRARY=false            # 音乐库宿主权限不对时，置 true 让容器一次性递归修正（大库很慢）

# ---- 安全 ----
# 后端密钥不在这里，在 musicbase/.env：
#   SECRET_KEY / ACOUSTID_API_KEY 等
# 本文件仍含数据库密码，务必：chmod 600 .env，并确认已被 .gitignore 排除。

