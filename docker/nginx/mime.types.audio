# ---------------------------------------------------------------------------
# 音频/歌词类型补充。
#
# ⚠️ 本表【只写官方 /etc/nginx/mime.types 里没有的扩展名】。
# ---------------------------------------------------------------------------
types {
    # 无损：本项目主要的两类文件之一
    audio/flac                                       flac;

    # PCM / 未压缩
    audio/wav                                        wav;
    audio/x-wav                                      wave;
    audio/x-aiff                                     aif aifc aiff;

    # 有损 & 流媒体常见封装
    audio/aac                                        aac;
    audio/mp4                                        m4b;
    audio/opus                                       opus;
    audio/ogg                                        oga spx;
    audio/mpeg                                       mp2 mpga mp1;

    # 无损 / 高解析小众格式
    audio/x-ape                                      ape mac;
    audio/x-dsf                                      dsf dff;
    audio/x-wavpack                                  wv;
    audio/x-shorten                                  shn;
    audio/x-tta                                      tta;
    audio/x-alac                                     alac;
    audio/x-ms-wma                                   wma;

    # 播放列表 / 歌词 / 音轨索引
    audio/x-scpls                                    pls;
    audio/mpegurl                                    m3u;
    audio/x-cue                                      cue;
}


